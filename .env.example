APP_NAME=TouchWood
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=touchwood
DB_USERNAME=touchwood
DB_PASSWORD=secret

# Sessions, cache and queues run on PostgreSQL for now; Redis comes back when traffic needs it
# (owner, 2026-09-18).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Media (config/platform.php): two different disks. Public holds only resized variants and sits
# behind the CDN; private holds every original and private document, served through signed links.
MEDIA_PUBLIC_DISK=public
MEDIA_PRIVATE_DISK=local
QUEUE_CONNECTION=database
# Two workers (config/queue.php; HANDOFF's deploy notes): the normal connection hands a job to
# another worker after 330 s, the long one (imports, store reads, nightly segments) after 3700 s.
QUEUE_LONG_CONNECTION=database-long
DB_QUEUE_RETRY_AFTER=330
DB_QUEUE_LONG=long
DB_QUEUE_LONG_RETRY_AFTER=3700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1


MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ops (ops.md §2.2): where its emails go. "log" writes them to the application log, for development
# and tests; "brevo" sends them through Brevo with BREVO_API_KEY. SMS go through the provider of the
# phone's country on the SMS countries list (access.md amendment 90); a provider's keys go here.
# With the key in, `php artisan ops:brevo:check` reads the account and senders, and sends nothing.
OPS_EMAIL_DRIVER=log
BREVO_API_KEY=
# The newsletter's lists (ops.md §1.9): "log" or "brevo" - one Brevo list per store and language, made
# in the folder named here. Brevo's webhook must send the secret as the X-TouchWood-Secret header.
OPS_NEWSLETTER_DRIVER=log
BREVO_NEWSLETTER_FOLDER_ID=
BREVO_WEBHOOK_SECRET=
# The nightly read of the lists' unsubscribes (ops.md §9.6 #1), 03:20 Riyadh: off until one real run at staging
# has shown the right people (docs/HANDOFF.md §15.4). Needs OPS_NEWSLETTER_DRIVER=brevo.
BREVO_NIGHTLY_READ=false

# Translate beside each English box (content.md §1.3): "deepl" sends staff text to DeepL with DEEPL_API_KEY
# (the owner's token); "fake" marks each text and sends nothing. Empty: "fake" in development and tests,
# "deepl" in production, where no key leaves Translate offered disabled.
TEXT_TRANSLATOR=
DEEPL_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
