<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Shared/Unit</directory>
            <directory>tests/Modules/*/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Shared/Integration</directory>
            <directory>tests/Modules/*/Integration</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Shared/Feature</directory>
            <directory>tests/Modules/*/Feature</directory>
        </testsuite>
        <!--
            A real browser, driven by Playwright. Every other suite asks the server what it would
            send; only this one asks whether a person can actually use the answer. Step 1 shipped
            six faults that every other suite called green (owner, 2026-09-22).
        -->
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" wins over an exported variable or .env: RefreshDatabase runs migrate:fresh,
            so these must never point tests at the development database or a shared cache.
            DB_HOST and DB_PORT are not forced so CI can set them.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <!-- The real cache store: PostgreSQL, as in production (owner, 2026-09-18). -->
        <env name="CACHE_STORE" value="database" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="touchwood_test" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <!-- The server renderer is a Node process; a test suite cannot depend on one being up.
             The fallback when it is down is tested on purpose in AdminPagesTest. -->
        <env name="INERTIA_SSR_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
